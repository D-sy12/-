{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@tarojs/taro", "webpack-env"],
    "lib": ["ES2017", "DOM"]
  },
  "include": ["./src", "./types", "./config"],
  "exclude": ["node_modules", "dist"]
}
